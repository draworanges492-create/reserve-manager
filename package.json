{
  "name": "reserve-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate-data": "tsx tools/validate-data.ts",
    "gen:placeholders": "tsx tools/generate-placeholders.ts",
    "gen:map": "tsx tools/generate-map.ts",
    "preview:art": "tsx tools/preview-art.ts",
    "sim:balance": "tsx tools/sim-balance.ts",
    "package:itch": "npm run build && rm -rf release && mkdir -p release && cd dist && zip -qr ../release/reserve-manager-web.zip ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
